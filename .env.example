# ---------------------------------------------------------------------------
# MESHAL JOB AUTOPILOT — environment configuration
# Copy to .env for local development. In Railway, set these as service
# variables. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3000
TZ=Asia/Riyadh

# Database (Railway provisions this automatically as DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meshal

# Dashboard auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Storage (local path in dev; mount a Railway volume in production)
STORAGE_DIR=./storage
SESSIONS_DIR=./storage/sessions
EVIDENCE_DIR=./storage/evidence

# Session/credential encryption
SESSION_ENCRYPTION_KEY=change-me-32-byte-key-base64

# ATS account credentials (per-ATS dedicated passwords, never the dashboard password)
ATS_ACCOUNT_PASSWORD=

# Email confirmation tracking (IMAP)
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# Candidate resume
RESUME_PATH=./storage/resume/cv.pdf

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Riyadh

# Playwright
PLAYWRIGHT_HEADLESS=true
